# ==================== LOCAL DEVELOPMENT ====================
# MONGODB_URI=mongodb://localhost:27017/jobportal

# ==================== MONGODB ATLAS (FREE) ====================
# Go to: https://www.mongodb.com/cloud/atlas
# Setup steps:
# 1. Create account (free)
# 2. Create M0 cluster (free forever)
# 3. Get connection string from "Connect" button
# 4. Replace <username> and <password>
# Example format:
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/jobportal?retryWrites=true&w=majority

# ==================== CLOUDINARY ====================
CLOUD_NAME=your_cloudinary_name
CLOUD_API_KEY=your_api_key
CLOUD_API_SECRET=your_api_secret

# ==================== FRONTEND URL ====================
# For Netlify: https://yoursite.netlify.app
FRONTEND_URL=http://localhost:5173

# ==================== PORT ====================
# Render will auto-set this
PORT=8000

# ==================== NODE ENVIRONMENT ====================
NODE_ENV=production
